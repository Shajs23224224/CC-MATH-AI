# C-MATH-AI runtime configuration template.
# Copy values into your local environment or deployment secret manager.
# Never commit real credentials.

APP_ENV=development
LOG_LEVEL=INFO

# Data
MARKET_DATA_PROVIDER=local
# MARKET_DATA_API_KEY=
# DATABASE_URL=

# Execution
BROKER_PROVIDER=none
# BROKER_API_KEY=
# BROKER_API_SECRET=
LIVE_EXECUTION_ENABLED=false

# Risk
RISK_MAX_POSITION_WEIGHT=0.10
RISK_MAX_PORTFOLIO_LEVERAGE=1.0
RISK_MAX_DAILY_LOSS=0.02
